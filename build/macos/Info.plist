<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist of LayerPeek.app (T-019). The release script (scripts/release-build.ps1, New-MacInfoPlist in
  scripts/ReleaseTools/ReleaseTools.psm1) replaces @VERSION@ with <Version> of Directory.Build.props; nothing else changes.
  The bundle identifier is the single source of the macOS identity (Preferences, Saved Application State, Caches,
  Login Items, notifications of T-020); AppEnvironment.ProductionBundleIdentifier must stay equal (a unit test checks it).
  LSUIElement: an agent app without a Dock icon and without a menu bar of its own; the UI is the menu bar extra.
  LSMinimumSystemVersion is the minimum of the Native AOT binary (LC_BUILD_VERSION minos of .NET 11 for osx-arm64).
  NSLocalNetworkUsageDescription (T-097): the explanation in the Local Network permission dialog of macOS 15+ (Apple TN3179),
  English here; the translations are build/macos/Localizations/<lang>.lproj/InfoPlist.strings (Contents/Resources of the
  bundle), one per app language, and CFBundleLocalizations lists the same languages.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>LayerPeek</string>
	<key>CFBundleExecutable</key>
	<string>LayerPeek</string>
	<key>CFBundleIconFile</key>
	<string>LayerPeek</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.pfoltynek.LayerPeek</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>cs</string>
		<string>sk</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>it</string>
		<string>pl</string>
	</array>
	<key>CFBundleName</key>
	<string>LayerPeek</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © Petr Foltýnek. GPL-3.0-only.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>LayerPeek connects to your Prusa printers and their cameras on your local network to show the print status and the camera view.</string>
</dict>
</plist>
