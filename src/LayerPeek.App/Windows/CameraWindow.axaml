<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LayerPeek.App.Cameras"
        xmlns:loc="using:LayerPeek.App.Localization"
        xmlns:ov="using:LayerPeek.App.Cameras.Overlay"
        xmlns:lay="using:LayerPeek.App.Cameras.Layout"
        xmlns:mini="using:LayerPeek.App.Cameras.Mini"
        x:Class="LayerPeek.App.Windows.CameraWindow"
        x:DataType="vm:CameraViewModel"
        Title="{Binding Title}"
        Width="960"
        Height="540"
        MinWidth="160"
        MinHeight="90"
        Background="Black"
        WindowStartupLocation="CenterScreen">
  <!--
    F11 toggles full screen; Esc leaves full screen to the mode it was entered from (normal window or mini preview) and the
    mini preview to the normal window. macOS (T-100) adds ⌃⌘F, ⌘. (= Esc) and ⌘W in CameraWindow.axaml.cs.
  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="F11" Command="{Binding ToggleFullScreenCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
  </Window.KeyBindings>

  <!--
    The context menu of the image (right click; Menu key / Shift+F10 on Windows; ⌃-click on macOS, whose texts never mention
    the keys of Windows, T-100) opens in the normal window outside the layout mode and in the mini preview
    (CameraWindow.LayoutMode.cs). "Edit layout" (T-091) only in the normal window, disabled with a tip below 480 × 300;
    "Always on top" (T-117) in both, always enabled, checked like the pin.
  -->
  <Window.ContextMenu>
    <ContextMenu AutomationProperties.AutomationId="CameraContextMenu" Opening="OnContextMenuOpening">
      <MenuItem AutomationProperties.AutomationId="CameraLayoutMenuItem"
                Header="{Binding [CameraLayoutEditMenu], Source={x:Static loc:LocalizedStrings.Instance}}"
                Command="{Binding EditLayoutCommand}"
                IsVisible="{Binding IsNormal}"
                ToolTip.Tip="{Binding LayoutToolTip}"
                ToolTip.ShowOnDisabled="True"
                ToolTip.ServiceEnabled="{Binding !HasLayoutRoom}">
        <MenuItem.Icon>
          <ov:OverlayIcon Width="16" Height="16" Data="{DynamicResource IconLayoutCellFour16Regular}" Foreground="{DynamicResource MenuFlyoutItemForeground}" />
        </MenuItem.Icon>
      </MenuItem>
      <!-- No icon: the check mark takes the icon column. -->
      <MenuItem AutomationProperties.AutomationId="CameraTopmostMenuItem"
                Header="{Binding [CameraTopmostMenu], Source={x:Static loc:LocalizedStrings.Instance}}"
                ToggleType="CheckBox"
                IsChecked="{Binding IsTopmost, Mode=OneWay}"
                Command="{Binding ToggleTopmostCommand}"
                IsVisible="{Binding !IsFullScreen}" />
    </ContextMenu>
  </Window.ContextMenu>

  <Window.Styles>
    <!--
      The window buttons appear while the pointer is over the window or a button has keyboard focus. The opacity is per
      button (a panel opacity would multiply): the pin stays visible, dimmed, while "always on top" is on (T-117 3). Later
      styles win: hidden, the checked pin dimmed, everything shown on hover / focus.
    -->
    <Style Selector="StackPanel.windowButtons > :is(Button)">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
      <Setter Property="Background" Value="#99000000" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="StackPanel.windowButtons > ToggleButton.topmostPin:checked">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Grid#Root:pointerover StackPanel.windowButtons > :is(Button), StackPanel.windowButtons:focus-within > :is(Button)">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!--
      Hover and press stay dark in every theme variant (the window is always black, T-117 Q-D2): the white icons never lie on
      a light Fluent background. The checked pin keeps the look of an unchecked button (no accent background, T-117 4).
    -->
    <Style Selector="StackPanel.windowButtons > ToggleButton.topmostPin:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#99000000" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrush}" />
    </Style>
    <Style Selector="StackPanel.windowButtons > :is(Button):pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#B3000000" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="StackPanel.windowButtons > :is(Button):pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#CC000000" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="StackPanel.windowButtons > ToggleButton.topmostPin:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#B3000000" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushPointerOver}" />
    </Style>
    <Style Selector="StackPanel.windowButtons > ToggleButton.topmostPin:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#CC000000" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushPressed}" />
    </Style>
    <!-- The pin: filled while "always on top" is on, regular while it is off; the state is the shape, not the colour. -->
    <Style Selector="ToggleButton.topmostPin ov|OverlayIcon">
      <Setter Property="Data" Value="{DynamicResource IconPin16Regular}" />
    </Style>
    <Style Selector="ToggleButton.topmostPin:checked ov|OverlayIcon">
      <Setter Property="Data" Value="{DynamicResource IconPin16Filled}" />
    </Style>
    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="White" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="None" />
    </Style>
    <Style Selector="Border.overlay">
      <Setter Property="Background" Value="#A6000000" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.overlay TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Cards of the overlay widgets (T-081): colours, icons, the card and its parts. -->
    <StyleInclude Source="avares://LayerPeek/Cameras/Overlay/OverlayStyles.axaml" />
    <!-- Resize grips of the borderless mini preview. -->
    <Style Selector="Border.grip">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Thin neutral outline of the borderless mini preview (T-118): fixed colours, the content is always black. -->
    <Style Selector="Border#MiniOutline">
      <Setter Property="BorderBrush" Value="#73FFFFFF" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Grid#Root:pointerover Border#MiniOutline">
      <Setter Property="BorderBrush" Value="#BFFFFFFF" />
    </Style>
  </Window.Styles>

  <!-- Row 0: the image and everything over it. Row 1: the info strip of the mini preview (T-089); empty in the other modes. -->
  <Grid x:Name="Root" Background="Black" RowDefinitions="*,Auto">
    <!-- Whole client area: double-click switches modes, dragging moves the mini preview. -->
    <Border x:Name="Surface"
            Background="Black"
            PointerPressed="OnSurfacePointerPressed"
            PointerMoved="OnSurfacePointerMoved"
            PointerReleased="OnSurfacePointerReleased"
            AutomationProperties.Name="{Binding ImageHint}">
      <Image x:Name="Video" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
    </Border>

    <!--
      Widget cards in six anchors (T-081, design T-076): normal window and full screen share the layout, the mini preview
      has none. Not a pointer target, so double-click and dragging work over the cards; below the connection state and
      the window buttons (the top right anchor starts below the buttons).
    -->
    <ov:OverlayAnchorsPanel x:Name="OverlayCards"
                            AutomationProperties.AutomationId="CameraOverlay"
                            IsVisible="{Binding Overlay.AreCardsVisible}"
                            IsHitTestVisible="False"
                            ClipToBounds="True">
      <ov:OverlayAnchorItems Anchor="TopLeft" AutomationProperties.AutomationId="CameraOverlayAnchorTopLeft" ItemsSource="{Binding Overlay.TopLeft}" />
      <ov:OverlayAnchorItems Anchor="TopCenter" AutomationProperties.AutomationId="CameraOverlayAnchorTopCenter" ItemsSource="{Binding Overlay.TopCenter}" />
      <ov:OverlayAnchorItems Anchor="TopRight" AutomationProperties.AutomationId="CameraOverlayAnchorTopRight" ItemsSource="{Binding Overlay.TopRight}" />
      <ov:OverlayAnchorItems Anchor="BottomLeft" AutomationProperties.AutomationId="CameraOverlayAnchorBottomLeft" ItemsSource="{Binding Overlay.BottomLeft}" />
      <ov:OverlayAnchorItems Anchor="BottomCenter" AutomationProperties.AutomationId="CameraOverlayAnchorBottomCenter" ItemsSource="{Binding Overlay.BottomCenter}" />
      <ov:OverlayAnchorItems Anchor="BottomRight" AutomationProperties.AutomationId="CameraOverlayAnchorBottomRight" ItemsSource="{Binding Overlay.BottomRight}" />
    </ov:OverlayAnchorsPanel>

    <!-- Connection state over the last image: connecting, no signal, error with its reason. -->
    <Border Classes="overlay"
            Padding="14,10"
            Margin="16"
            MaxWidth="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding IsStatusVisible}">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock Text="{Binding StatusDetail}"
                   IsVisible="{Binding HasStatusDetail}"
                   FontSize="12"
                   Opacity="0.85"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
      </StackPanel>
    </Border>

    <StackPanel x:Name="WindowButtons"
                AutomationProperties.AutomationId="CameraWindowButtons"
                Classes="windowButtons"
                Button.Click="OnWindowButtonClick"
                IsVisible="{Binding !IsLayoutModeActive}"
                Orientation="Horizontal"
                Spacing="4"
                Margin="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
      <!--
        Every mode shows the buttons of the other two, always in this order: normal window [full screen][mini preview],
        mini preview [full screen][normal window], full screen [normal window][mini preview]. The normal window has
        "Edit layout" first (T-091, T-076 3.2), the normal window and the mini preview the pin last (T-117); all hidden
        while the layout mode is on.
      -->
      <Button AutomationProperties.AutomationId="CameraLayoutButton"
              Command="{Binding EditLayoutCommand}"
              IsVisible="{Binding IsNormal}"
              ToolTip.Tip="{Binding LayoutToolTip}"
              ToolTip.ShowOnDisabled="True"
              AutomationProperties.Name="{Binding LayoutToolTip}">
        <ov:OverlayIcon Width="16" Height="16" Data="{DynamicResource IconLayoutCellFour16Regular}" Foreground="White" />
      </Button>
      <Button AutomationProperties.AutomationId="CameraFullScreenButton"
              Command="{Binding ShowFullScreenCommand}"
              IsVisible="{Binding !IsFullScreen}"
              ToolTip.Tip="{Binding FullScreenToolTip}"
              AutomationProperties.Name="{Binding FullScreenToolTip}">
        <Path Classes="icon" Data="M1,5 V1 H5 M11,1 H15 V5 M15,11 V15 H11 M5,15 H1 V11" />
      </Button>
      <Button AutomationProperties.AutomationId="CameraNormalButton"
              Command="{Binding ShowNormalCommand}"
              IsVisible="{Binding !IsNormal}"
              ToolTip.Tip="{Binding NormalToolTip}"
              AutomationProperties.Name="{Binding NormalToolTip}">
        <Path Classes="icon" Data="M2,3 H14 V13 H2 Z M2,5 H14" />
      </Button>
      <Button AutomationProperties.AutomationId="CameraMiniButton"
              Command="{Binding ShowMiniCommand}"
              IsVisible="{Binding !IsMini}"
              ToolTip.Tip="{Binding MiniToolTip}"
              AutomationProperties.Name="{Binding MiniToolTip}">
        <Grid>
          <Path Classes="icon" Data="M1,2 H15 V14 H1 Z" />
          <Path Classes="icon" Fill="White" Data="M8,8 H13 V12 H8 Z" />
        </Grid>
      </Button>
      <!--
        The pin (T-117): always last, in the corner, so that the dimmed pin stays where it is in both modes; not in full
        screen, which is never on top. Space / Enter switch it; the focus stays on it (OnWindowButtonClick).
      -->
      <ToggleButton Classes="topmostPin"
                    AutomationProperties.AutomationId="CameraTopmostButton"
                    IsChecked="{Binding IsTopmost, Mode=OneWay}"
                    Command="{Binding ToggleTopmostCommand}"
                    IsVisible="{Binding !IsFullScreen}"
                    ToolTip.Tip="{Binding TopmostToolTip}"
                    AutomationProperties.Name="{Binding TopmostToolTip}">
        <ov:OverlayIcon Width="16" Height="16" CanvasSize="16" Foreground="White" />
      </ToggleButton>
    </StackPanel>

    <!--
      Mini preview (T-089): the info strip below the image, not over it. Pressing and dragging it moves the window like the
      image (not over its buttons, which handle their presses). Keep the mini preview parts in this region. Above the resize
      grips (ZIndex, T-090): its toggle buttons take presses there, its own hit test leaves the other edges to the grips.
    -->
    <Panel Grid.Row="1" ZIndex="1" IsVisible="{Binding IsMini}">
      <mini:CameraMiniStrip x:Name="MiniStrip"
                            DataContext="{Binding MiniStrip}"
                            PointerPressed="OnSurfacePointerPressed"
                            PointerMoved="OnSurfacePointerMoved"
                            PointerReleased="OnSurfacePointerReleased" />
    </Panel>

    <!-- The mini preview has no window frame: these edges resize it (also along the strip). -->
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsMini}" RowDefinitions="6,*,6" ColumnDefinitions="6,*,6">
      <Border Classes="grip" Grid.Row="0" Grid.Column="0" Cursor="TopLeftCorner" Tag="{x:Static WindowEdge.NorthWest}" PointerPressed="OnGripPointerPressed" />
      <Border Classes="grip" Grid.Row="0" Grid.Column="1" Cursor="SizeNorthSouth" Tag="{x:Static WindowEdge.North}" PointerPressed="OnGripPointerPressed" />
      <Border Classes="grip" Grid.Row="0" Grid.Column="2" Cursor="TopRightCorner" Tag="{x:Static WindowEdge.NorthEast}" PointerPressed="OnGripPointerPressed" />
      <Border Classes="grip" Grid.Row="1" Grid.Column="0" Cursor="SizeWestEast" Tag="{x:Static WindowEdge.West}" PointerPressed="OnGripPointerPressed" />
      <Border Classes="grip" Grid.Row="1" Grid.Column="2" Cursor="SizeWestEast" Tag="{x:Static WindowEdge.East}" PointerPressed="OnGripPointerPressed" />
      <Border Classes="grip" Grid.Row="2" Grid.Column="0" Cursor="BottomLeftCorner" Tag="{x:Static WindowEdge.SouthWest}" PointerPressed="OnGripPointerPressed" />
      <Border Classes="grip" Grid.Row="2" Grid.Column="1" Cursor="SizeNorthSouth" Tag="{x:Static WindowEdge.South}" PointerPressed="OnGripPointerPressed" />
      <Border Classes="grip" Grid.Row="2" Grid.Column="2" Cursor="BottomRightCorner" Tag="{x:Static WindowEdge.SouthEast}" PointerPressed="OnGripPointerPressed" />
    </Grid>

    <!--
      Outline of the mini preview (T-118): over the image and the strip, not a pointer target, no layout change. Layout
      rounding (on by default) draws the 1 DIP as whole device pixels: 1 px at 100/125 %, 2 px at 150-200 %.
    -->
    <Border x:Name="MiniOutline"
            Grid.RowSpan="2"
            ZIndex="2"
            BorderThickness="1"
            IsHitTestVisible="False"
            IsVisible="{Binding IsMini}" />

    <!-- Layout mode (T-091): above everything while it is on; its live region for screen readers is always there. -->
    <lay:CameraLayoutOverlay x:Name="LayoutOverlay" DataContext="{Binding LayoutMode}" />
  </Grid>
</Window>
