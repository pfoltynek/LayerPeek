<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LayerPeek.App.Settings"
        xmlns:loc="using:LayerPeek.App.Localization"
        xmlns:printers="using:LayerPeek.App.Printers"
        x:Class="LayerPeek.App.Windows.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding [SettingsTitle], Source={x:Static loc:LocalizedStrings.Instance}}"
        Width="780"
        Height="508"
        MinWidth="640"
        MinHeight="400"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterScreen">
  <!--
    Layout of T-033: the window (client 780 × 508 DIP, plus a title bar of about 32) fits an 800 × 600 screen at 100 %
    without scrolling, in every language and with every validation message and test result. AuxiliaryWindowPlacement
    shrinks it to a smaller work area; the scroll viewers of the (sub-)tabs are only the fallback for that case and for the
    notice bar at the top. Sizes and spacing follow the approved design in the task (T-033, "Návrh UI").
    T-040: only the close button in the title bar (no minimize, no maximize); the window stays resizable.
  -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SettingsErrorBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="SettingsSuccessBrush" Color="#0F7B0F" />
          <SolidColorBrush x:Key="NoticeBrush" Color="#FFF4E5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SettingsErrorBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="SettingsSuccessBrush" Color="#6CCB5F" />
          <SolidColorBrush x:Key="NoticeBrush" Color="#4A3410" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SettingsErrorBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,4" />
    </Style>
    <Style Selector="TextBlock.marker">
      <Setter Property="Foreground" Value="{DynamicResource SettingsErrorBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <!-- Test results: running / cancelled in the normal text colour, success green, failure red. -->
    <Style Selector="TextBlock.result">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.result.success">
      <Setter Property="Foreground" Value="{DynamicResource SettingsSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.result.failure">
      <Setter Property="Foreground" Value="{DynamicResource SettingsErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.status.isError">
      <Setter Property="Foreground" Value="{DynamicResource SettingsErrorBrush}" />
    </Style>
    <!--
      Overlay table (T-036): column headers over the check boxes, at most 2 lines in 120 DIP (13 px: es "pantalla completa"
      does not fit 120 DIP at 14 px semi-bold), check boxes centred in their column.
    -->
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="CheckBox.cell">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <!-- Main tabs smaller than the Fluent default (24 px / 48 DIP), printer sub-tabs smaller still. -->
    <Style Selector="TabControl.main, TabControl.sub">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabControl.main > TabItem">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="TabControl.sub > TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </Window.Styles>

  <!-- Declared in reading order, which is also the Tab order: notice, tabs with their content, then Save / Cancel. -->
  <Grid Margin="16,8,16,12" RowDefinitions="Auto,Auto,*,Auto">
    <Border Background="{DynamicResource NoticeBrush}"
            CornerRadius="4"
            Padding="10,6"
            Margin="0,0,0,8"
            IsVisible="{Binding HasNotice}">
      <TextBlock AutomationProperties.AutomationId="SettingsNotice" Text="{Binding Notice}" TextWrapping="Wrap" />
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding [SettingsLoading], Source={x:Static loc:LocalizedStrings.Instance}}" IsVisible="{Binding IsLoading}" Margin="0,0,0,8" />

    <TabControl x:Name="MainTabs"
                Grid.Row="2"
                Classes="main"
                AutomationProperties.AutomationId="SettingsTabs"
                SelectedIndex="{Binding SelectedTabIndex}"
                IsEnabled="{Binding IsEditable}">
      <!-- Printers: list on the left, sub-tabs of the selected printer on the right. -->
      <TabItem AutomationProperties.AutomationId="SettingsTabPrinters" Header="{Binding [SettingsTabPrinters], Source={x:Static loc:LocalizedStrings.Instance}}">
        <Grid ColumnDefinitions="184,16,*" Margin="0,8,0,0">
          <Grid RowDefinitions="*,Auto">
            <ListBox AutomationProperties.AutomationId="SettingsPrinterList" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PrinterEditorViewModel">
                  <!-- T-039: the printer image 24 × 24, 8, the "!" (only with an error), the name. The image is decorative here. -->
                  <Grid ColumnDefinitions="24,8,Auto,*">
                    <printers:PrinterImageView AutomationProperties.AutomationId="PrinterListImage" Width="24" Height="24" VerticalAlignment="Center" Picture="{Binding Picture}" />
                    <TextBlock Grid.Column="2" Classes="marker" Text="!" VerticalAlignment="Center" IsVisible="{Binding ShowsErrorMarker}" />
                    <TextBlock Grid.Column="3" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,0">
              <Button AutomationProperties.AutomationId="SettingsAddPrinter"
                      HorizontalAlignment="Stretch"
                      Content="{Binding [SettingsAddPrinter], Source={x:Static loc:LocalizedStrings.Instance}}"
                      Command="{Binding AddPrinterCommand}" />
              <Button AutomationProperties.AutomationId="SettingsRemovePrinter"
                      HorizontalAlignment="Stretch"
                      Content="{Binding [SettingsRemovePrinter], Source={x:Static loc:LocalizedStrings.Instance}}"
                      Command="{Binding RemovePrinterCommand}" />
            </StackPanel>
          </Grid>

          <TextBlock Grid.Column="2"
                     Text="{Binding [SettingsNoPrinters], Source={x:Static loc:LocalizedStrings.Instance}}"
                     IsVisible="{Binding HasNoPrinters}"
                     TextWrapping="Wrap"
                     Opacity="0.75" />

          <!-- The selected sub-tab belongs to the window, so it stays when another printer is selected. -->
          <TabControl x:Name="PrinterTabs"
                      Grid.Column="2"
                      Classes="sub"
                      AutomationProperties.AutomationId="SettingsPrinterTabs"
                      SelectedIndex="{Binding SelectedPrinterTabIndex}"
                      IsVisible="{Binding HasSelectedPrinter}">
            <!-- Printer: name, connection, address, user name, password, test. -->
            <TabItem AutomationProperties.AutomationId="PrinterTabConnection"
                     AutomationProperties.Name="{Binding SelectedPrinter.ConnectionTabName, FallbackValue={x:Null}}">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock AutomationProperties.AutomationId="PrinterTabConnectionMarker" Classes="marker" Text="!" IsVisible="{Binding SelectedPrinter.ShowsConnectionErrorMarker, FallbackValue=False}" />
                  <TextBlock Text="{Binding [SettingsPrinterTabConnection], Source={x:Static loc:LocalizedStrings.Instance}}" />
                </StackPanel>
              </TabItem.Header>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ContentControl Content="{Binding SelectedPrinter}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:PrinterEditorViewModel">
                      <StackPanel>
                        <!--
                          The printer image (T-039): a 56 × 56 button with a menu left of the name and connection, which stand
                          side by side; the name error spans both (the connection never has one). An image import error is shown in
                          the status line at the bottom: with every other message shown, the form has no room for another line.
                        -->
                        <Grid ColumnDefinitions="56,12,*,16,320" RowDefinitions="Auto,Auto,Auto">
                          <Button Grid.RowSpan="2"
                                  AutomationProperties.AutomationId="PrinterImageButton"
                                  AutomationProperties.Name="{Binding ImageName}"
                                  ToolTip.Tip="{Binding [SettingsImageButtonToolTip], Source={x:Static loc:LocalizedStrings.Instance}}"
                                  Width="56"
                                  Height="56"
                                  Padding="0"
                                  VerticalAlignment="Bottom"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch">
                            <Grid>
                              <printers:PrinterImageView AutomationProperties.AutomationId="PrinterImage" Picture="{Binding Picture}" />
                              <!-- The button opens a menu: a small chevron in the corner, on the button colour. -->
                              <Border Width="14"
                                      Height="14"
                                      CornerRadius="7"
                                      Margin="0,0,1,1"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Background="{DynamicResource ButtonBackground}">
                                <Path Data="M 0,0 L 4,4 L 8,0"
                                      Stroke="{DynamicResource ButtonForeground}"
                                      StrokeThickness="1.5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                              </Border>
                            </Grid>
                            <Button.Flyout>
                              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem AutomationProperties.AutomationId="PrinterImageAutomatic"
                                          Header="{Binding AutomaticImageText}"
                                          Command="{Binding UseAutomaticImageCommand}"
                                          ToggleType="Radio"
                                          IsChecked="{Binding IsAutomaticImage, Mode=OneWay}" />
                                <MenuItem AutomationProperties.AutomationId="PrinterImageModels"
                                          Header="{Binding [SettingsImageChooseModel], Source={x:Static loc:LocalizedStrings.Instance}}"
                                          ItemsSource="{Binding ModelOptions}">
                                  <MenuItem.ItemContainerTheme>
                                    <ControlTheme x:DataType="vm:PrinterModelOption" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                      <Setter Property="Header" Value="{Binding Text}" />
                                      <Setter Property="Command" Value="{Binding Command}" />
                                      <Setter Property="ToggleType" Value="Radio" />
                                      <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
                                    </ControlTheme>
                                  </MenuItem.ItemContainerTheme>
                                </MenuItem>
                                <Separator />
                                <MenuItem AutomationProperties.AutomationId="PrinterImageCustom"
                                          Header="{Binding [SettingsImageCustom], Source={x:Static loc:LocalizedStrings.Instance}}"
                                          Command="{Binding ChooseCustomImageCommand}"
                                          ToggleType="Radio"
                                          IsChecked="{Binding IsCustomImage, Mode=OneWay}" />
                                <MenuItem AutomationProperties.AutomationId="PrinterImageRemoveCustom"
                                          Header="{Binding [SettingsImageRemoveCustom], Source={x:Static loc:LocalizedStrings.Instance}}"
                                          Command="{Binding RemoveCustomImageCommand}" />
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                          <TextBlock Grid.Column="2" Classes="label" Text="{Binding [SettingsName], Source={x:Static loc:LocalizedStrings.Instance}}" />
                          <TextBox Grid.Row="1"
                                   Grid.Column="2"
                                   AutomationProperties.AutomationId="PrinterName"
                                   AutomationProperties.Name="{Binding [SettingsName], Source={x:Static loc:LocalizedStrings.Instance}}"
                                   Text="{Binding Name}"
                                   MaxLength="200" />
                          <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" AutomationProperties.AutomationId="PrinterNameError" Classes="error" Text="{Binding NameError}" IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <TextBlock Grid.Column="4" Classes="label" Text="{Binding [SettingsConnectionType], Source={x:Static loc:LocalizedStrings.Instance}}" />
                          <ComboBox Grid.Column="4"
                                    Grid.Row="1"
                                    AutomationProperties.AutomationId="PrinterConnectionType"
                                    AutomationProperties.Name="{Binding [SettingsConnectionType], Source={x:Static loc:LocalizedStrings.Instance}}"
                                    ItemsSource="{Binding ConnectionTypes}"
                                    SelectedItem="{Binding SelectedConnectionType}"
                                    HorizontalAlignment="Stretch">
                            <ComboBox.Styles>
                              <Style Selector="ComboBoxItem" x:DataType="vm:ConnectionTypeOption">
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                              </Style>
                            </ComboBox.Styles>
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:ConnectionTypeOption">
                                <TextBlock Text="{Binding Text}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </Grid>

                        <!-- An error replaces the hint of its field while it is shown (T-033). -->
                        <TextBlock Classes="label" Margin="0,8,0,4" Text="{Binding [SettingsAddress], Source={x:Static loc:LocalizedStrings.Instance}}" />
                        <TextBox AutomationProperties.AutomationId="PrinterAddress"
                                 AutomationProperties.Name="{Binding [SettingsAddress], Source={x:Static loc:LocalizedStrings.Instance}}"
                                 Text="{Binding Address}"
                                 PlaceholderText="192.168.1.20" />
                        <TextBlock AutomationProperties.AutomationId="PrinterAddressHint" Classes="hint" Text="{Binding [SettingsAddressHint], Source={x:Static loc:LocalizedStrings.Instance}}" IsVisible="{Binding ShowsAddressHint}" />
                        <TextBlock AutomationProperties.AutomationId="PrinterAddressError" Classes="error" Text="{Binding AddressError}" IsVisible="{Binding AddressError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <Grid ColumnDefinitions="*,16,*" Margin="0,8,0,0">
                          <StackPanel>
                            <TextBlock AutomationProperties.AutomationId="PrinterUserNameLabel" Classes="label" Text="{Binding [SettingsUserName], Source={x:Static loc:LocalizedStrings.Instance}}" />
                            <TextBox AutomationProperties.AutomationId="PrinterUserName"
                                     AutomationProperties.Name="{Binding [SettingsUserName], Source={x:Static loc:LocalizedStrings.Instance}}"
                                     Text="{Binding UserName}"
                                     MaxLength="200"
                                     IsEnabled="{Binding IsPrusaLink}" />
                            <TextBlock AutomationProperties.AutomationId="PrinterUserNameHint" Classes="hint" Text="{Binding UserNameHint}" IsVisible="{Binding ShowsUserNameHint}" />
                            <TextBlock AutomationProperties.AutomationId="PrinterUserNameError" Classes="error" Text="{Binding UserNameError}" IsVisible="{Binding UserNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Classes="label" Text="{Binding [SettingsPassword], Source={x:Static loc:LocalizedStrings.Instance}}" />
                            <TextBox AutomationProperties.AutomationId="PrinterPassword"
                                     AutomationProperties.Name="{Binding [SettingsPassword], Source={x:Static loc:LocalizedStrings.Instance}}"
                                     Text="{Binding Password}"
                                     PasswordChar="●"
                                     PlaceholderText="{Binding PasswordWatermark}"
                                     IsEnabled="{Binding IsPasswordEnabled}" />
                            <TextBlock AutomationProperties.AutomationId="PrinterPasswordHint" Classes="hint" Text="{Binding PasswordHint}" IsVisible="{Binding ShowsPasswordHint}" />
                            <TextBlock AutomationProperties.AutomationId="PrinterPasswordError" Classes="error" Text="{Binding PasswordError}" IsVisible="{Binding PasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </StackPanel>
                        </Grid>

                        <!-- The result wraps right of the buttons. -->
                        <Grid ColumnDefinitions="Auto,*" Margin="0,12,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button AutomationProperties.AutomationId="PrinterTestConnection" Content="{Binding [SettingsTestConnection], Source={x:Static loc:LocalizedStrings.Instance}}" Command="{Binding TestConnectionCommand}" />
                            <Button AutomationProperties.AutomationId="PrinterCancelTest" Content="{Binding [SettingsCancelTest], Source={x:Static loc:LocalizedStrings.Instance}}" Command="{Binding CancelTestCommand}" IsVisible="{Binding IsTesting}" />
                            <ProgressBar IsIndeterminate="True" Width="48" MinWidth="48" VerticalAlignment="Center" IsVisible="{Binding IsTesting}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     AutomationProperties.AutomationId="PrinterTestResult"
                                     Classes="result"
                                     Classes.success="{Binding TestSucceeded}"
                                     Classes.failure="{Binding TestFailed}"
                                     Text="{Binding TestResultText}"
                                     IsVisible="{Binding HasTestResult}"
                                     VerticalAlignment="Top"
                                     Margin="12,6,0,0" />
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </ScrollViewer>
            </TabItem>

            <!-- Camera (T-014): RTSP stream shown from the tray menu, with the snapshot of the Test button (T-034). -->
            <TabItem AutomationProperties.AutomationId="PrinterTabCamera"
                     AutomationProperties.Name="{Binding SelectedPrinter.CameraTabName, FallbackValue={x:Null}}">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock AutomationProperties.AutomationId="PrinterTabCameraMarker" Classes="marker" Text="!" IsVisible="{Binding SelectedPrinter.ShowsCameraErrorMarker, FallbackValue=False}" />
                  <TextBlock Text="{Binding [SettingsCamera], Source={x:Static loc:LocalizedStrings.Instance}}" />
                </StackPanel>
              </TabItem.Header>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ContentControl Content="{Binding SelectedPrinter}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:PrinterEditorViewModel">
                      <StackPanel>
                        <Border Background="{DynamicResource NoticeBrush}"
                                CornerRadius="4"
                                Padding="10,6"
                                Margin="0,0,0,8"
                                IsVisible="{Binding CameraCredentialsRemoved}">
                          <TextBlock AutomationProperties.AutomationId="PrinterCameraCredentialsRemoved" FontSize="12" Text="{Binding [SettingsCameraCredentialsRemoved], Source={x:Static loc:LocalizedStrings.Instance}}" TextWrapping="Wrap" />
                        </Border>
                        <CheckBox AutomationProperties.AutomationId="PrinterCameraEnabled" Content="{Binding [SettingsCameraEnabled], Source={x:Static loc:LocalizedStrings.Instance}}" IsChecked="{Binding CameraEnabled}" />
                        <TextBlock Classes="label" Margin="0,8,0,4" Text="{Binding [SettingsCameraUrl], Source={x:Static loc:LocalizedStrings.Instance}}" />
                        <TextBox AutomationProperties.AutomationId="PrinterCameraUrl"
                                 Text="{Binding CameraUrl}"
                                 PlaceholderText="rtsp://192.168.0.227/live"
                                 AutomationProperties.Name="{Binding [SettingsCameraUrl], Source={x:Static loc:LocalizedStrings.Instance}}" />
                        <TextBlock AutomationProperties.AutomationId="PrinterCameraUrlHint" Classes="hint" Text="{Binding [SettingsCameraUrlHint], Source={x:Static loc:LocalizedStrings.Instance}}" IsVisible="{Binding ShowsCameraUrlHint}" />
                        <TextBlock AutomationProperties.AutomationId="PrinterCameraUrlError" Classes="error" Text="{Binding CameraUrlError}" IsVisible="{Binding CameraUrlError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <!--
                          Snapshot of a successful test (T-034) left of the button and its result: a 320 × 180 frame, the
                          image scaled with its aspect ratio kept (black bands like the camera window). Nothing is reserved
                          while there is no snapshot; the button and the result then start at the left edge.
                        -->
                        <Grid ColumnDefinitions="Auto,*" Margin="0,12,0,0">
                          <Border AutomationProperties.AutomationId="PrinterCameraPreviewFrame"
                                  Width="320"
                                  Height="180"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Top"
                                  Background="Black"
                                  IsVisible="{Binding HasCameraPreview}">
                            <Image AutomationProperties.AutomationId="PrinterCameraPreview"
                                   AutomationProperties.Name="{Binding [SettingsCameraPreview], Source={x:Static loc:LocalizedStrings.Instance}}"
                                   Source="{Binding CameraPreview}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button AutomationProperties.AutomationId="PrinterCameraTest" Content="{Binding [SettingsCameraTest], Source={x:Static loc:LocalizedStrings.Instance}}" Command="{Binding TestCameraCommand}" />
                              <Button AutomationProperties.AutomationId="PrinterCameraCancelTest" Content="{Binding [SettingsCancelTest], Source={x:Static loc:LocalizedStrings.Instance}}" Command="{Binding CancelCameraTestCommand}" IsVisible="{Binding IsTestingCamera}" />
                              <ProgressBar IsIndeterminate="True" Width="48" MinWidth="48" VerticalAlignment="Center" IsVisible="{Binding IsTestingCamera}" />
                            </StackPanel>
                            <TextBlock AutomationProperties.AutomationId="PrinterCameraTestResult"
                                       Classes="result"
                                       Classes.success="{Binding CameraTestSucceeded}"
                                       Classes.failure="{Binding CameraTestFailed}"
                                       Text="{Binding CameraTestResultText}"
                                       IsVisible="{Binding HasCameraTestResult}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </ScrollViewer>
            </TabItem>

            <!--
              Camera window (T-035): how the window opens. The fields are disabled (values kept) while the camera is off.
              The last column (88) is "Always on top" (T-037; applies to open camera windows after saving).
            -->
            <TabItem AutomationProperties.AutomationId="PrinterTabCameraWindow"
                     AutomationProperties.Name="{Binding SelectedPrinter.CameraWindowTabName, FallbackValue={x:Null}}">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock AutomationProperties.AutomationId="PrinterTabCameraWindowMarker" Classes="marker" Text="!" IsVisible="{Binding SelectedPrinter.ShowsCameraWindowErrorMarker, FallbackValue=False}" />
                  <TextBlock Text="{Binding [SettingsPrinterTabCameraWindow], Source={x:Static loc:LocalizedStrings.Instance}}" />
                </StackPanel>
              </TabItem.Header>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ContentControl Content="{Binding SelectedPrinter}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:PrinterEditorViewModel">
                      <StackPanel>
                        <TextBlock AutomationProperties.AutomationId="PrinterCameraWindowCameraOff"
                                   Classes="hint"
                                   Margin="0,0,0,8"
                                   Text="{Binding [SettingsCameraWindowCameraOff], Source={x:Static loc:LocalizedStrings.Instance}}"
                                   IsVisible="{Binding !CameraEnabled}" />
                        <StackPanel AutomationProperties.AutomationId="PrinterCameraWindowFields" IsEnabled="{Binding CameraEnabled}">
                          <CheckBox AutomationProperties.AutomationId="PrinterCameraWindowRemember"
                                    Content="{Binding [SettingsCameraWindowRemember], Source={x:Static loc:LocalizedStrings.Instance}}"
                                    IsChecked="{Binding RememberLastPlacement}" />
                          <TextBlock AutomationProperties.AutomationId="PrinterCameraWindowRememberHint" Classes="hint" Margin="28,0,0,0" Text="{Binding [SettingsCameraWindowRememberHint], Source={x:Static loc:LocalizedStrings.Instance}}" />

                          <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,8,Auto" Margin="0,12,0,0">
                            <TextBlock VerticalAlignment="Center" Text="{Binding [SettingsCameraWindowStartMode], Source={x:Static loc:LocalizedStrings.Instance}}" />
                            <ComboBox Grid.Column="2"
                                      AutomationProperties.AutomationId="PrinterCameraWindowStartMode"
                                      AutomationProperties.Name="{Binding [SettingsCameraWindowStartMode], Source={x:Static loc:LocalizedStrings.Instance}}"
                                      ItemsSource="{Binding StartModeOptions}"
                                      SelectedItem="{Binding SelectedStartMode}"
                                      MinWidth="220">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CameraStartModeOption">
                                  <TextBlock Text="{Binding Text}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding [SettingsCameraWindowMonitor], Source={x:Static loc:LocalizedStrings.Instance}}" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="2"
                                      AutomationProperties.AutomationId="PrinterCameraWindowMonitor"
                                      AutomationProperties.Name="{Binding [SettingsCameraWindowMonitor], Source={x:Static loc:LocalizedStrings.Instance}}"
                                      ItemsSource="{Binding MonitorOptions}"
                                      SelectedItem="{Binding SelectedMonitor}"
                                      HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CameraMonitorOption">
                                  <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </Grid>

                          <!--
                            Rows: normal window, mini preview; columns: size (editable, presets + "W × H"), position, always on top (T-037).
                            No top margin of its own (T-040): the section headers bring 16 DIP, which keeps room for the buttons below.
                          -->
                          <Grid ColumnDefinitions="Auto,12,140,12,*,12,88" RowDefinitions="Auto,4,Auto,Auto,8,Auto,Auto">
                            <TextBlock Grid.Column="2" Classes="section" VerticalAlignment="Bottom" Text="{Binding [SettingsCameraWindowSize], Source={x:Static loc:LocalizedStrings.Instance}}" />
                            <TextBlock Grid.Column="4" Classes="section" VerticalAlignment="Bottom" Text="{Binding [SettingsCameraWindowPosition], Source={x:Static loc:LocalizedStrings.Instance}}" />
                            <TextBlock Grid.Column="6"
                                       AutomationProperties.AutomationId="PrinterCameraWindowTopmostHeader"
                                       Classes="section"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding [SettingsCameraWindowTopmost], Source={x:Static loc:LocalizedStrings.Instance}}" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding [SettingsCameraWindowNormal], Source={x:Static loc:LocalizedStrings.Instance}}" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="2"
                                      AutomationProperties.AutomationId="PrinterCameraWindowNormalSize"
                                      AutomationProperties.Name="{Binding NormalSizeName}"
                                      IsEditable="True"
                                      ItemsSource="{x:Static vm:CameraWindowSizeText.Presets}"
                                      Text="{Binding NormalSizeText, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="4"
                                      AutomationProperties.AutomationId="PrinterCameraWindowNormalCorner"
                                      AutomationProperties.Name="{Binding NormalCornerName}"
                                      ItemsSource="{Binding CornerOptions}"
                                      SelectedItem="{Binding SelectedNormalCorner}"
                                      HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CameraCornerOption">
                                  <TextBlock Text="{Binding Text}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Grid.Row="2"
                                      Grid.Column="6"
                                      AutomationProperties.AutomationId="PrinterCameraWindowNormalTopmost"
                                      AutomationProperties.Name="{Binding NormalTopmostName}"
                                      HorizontalAlignment="Center"
                                      IsChecked="{Binding TopmostNormal}" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="2"
                                       Grid.ColumnSpan="5"
                                       AutomationProperties.AutomationId="PrinterCameraWindowNormalSizeError"
                                       Classes="error"
                                       Text="{Binding NormalSizeError}"
                                       IsVisible="{Binding NormalSizeError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="{Binding [SettingsCameraWindowMini], Source={x:Static loc:LocalizedStrings.Instance}}" />
                            <ComboBox Grid.Row="5"
                                      Grid.Column="2"
                                      AutomationProperties.AutomationId="PrinterCameraWindowMiniSize"
                                      AutomationProperties.Name="{Binding MiniSizeName}"
                                      IsEditable="True"
                                      ItemsSource="{x:Static vm:CameraWindowSizeText.Presets}"
                                      Text="{Binding MiniSizeText, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Row="5"
                                      Grid.Column="4"
                                      AutomationProperties.AutomationId="PrinterCameraWindowMiniCorner"
                                      AutomationProperties.Name="{Binding MiniCornerName}"
                                      ItemsSource="{Binding CornerOptions}"
                                      SelectedItem="{Binding SelectedMiniCorner}"
                                      HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CameraCornerOption">
                                  <TextBlock Text="{Binding Text}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Grid.Row="5"
                                      Grid.Column="6"
                                      AutomationProperties.AutomationId="PrinterCameraWindowMiniTopmost"
                                      AutomationProperties.Name="{Binding MiniTopmostName}"
                                      HorizontalAlignment="Center"
                                      IsChecked="{Binding TopmostMini}" />
                            <TextBlock Grid.Row="6"
                                       Grid.Column="2"
                                       Grid.ColumnSpan="5"
                                       AutomationProperties.AutomationId="PrinterCameraWindowMiniSizeError"
                                       Classes="error"
                                       Text="{Binding MiniSizeError}"
                                       IsVisible="{Binding MiniSizeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </Grid>

                          <!-- T-040: values of this sub-tab back to the defaults; Apply = Save + place the open camera window again. -->
                          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button AutomationProperties.AutomationId="PrinterCameraWindowReset"
                                    Content="{Binding [SettingsCameraWindowReset], Source={x:Static loc:LocalizedStrings.Instance}}"
                                    Command="{Binding ResetCameraWindowCommand}" />
                            <Button AutomationProperties.AutomationId="PrinterCameraWindowApply"
                                    MinWidth="96"
                                    Content="{Binding [SettingsCameraWindowApply], Source={x:Static loc:LocalizedStrings.Instance}}"
                                    Command="{Binding ApplyCameraWindowCommand}" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </ScrollViewer>
            </TabItem>

            <!--
              Overlay (T-036): what the camera window shows over the image and in which corner. Rows: the items, printer data
              first, then job data; columns: the normal window (also full screen) and the mini preview. The table is disabled
              (values kept) while the camera is off; the hints on the right stay readable.
            -->
            <TabItem AutomationProperties.AutomationId="PrinterTabOverlay">
              <TabItem.Header>
                <TextBlock Text="{Binding [SettingsPrinterTabOverlay], Source={x:Static loc:LocalizedStrings.Instance}}" />
              </TabItem.Header>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ContentControl Content="{Binding SelectedPrinter}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:PrinterEditorViewModel">
                      <Grid ColumnDefinitions="Auto,16,*">
                        <Grid AutomationProperties.AutomationId="PrinterOverlayFields"
                              IsEnabled="{Binding CameraEnabled}"
                              ColumnDefinitions="Auto,120,120"
                              RowDefinitions="Auto,32,32,32,32,32,32,32,32,32">
                          <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock Classes="label" Text="{Binding [SettingsOverlayCorner], Source={x:Static loc:LocalizedStrings.Instance}}" />
                            <ComboBox AutomationProperties.AutomationId="PrinterOverlayCorner"
                                      AutomationProperties.Name="{Binding [SettingsOverlayCorner], Source={x:Static loc:LocalizedStrings.Instance}}"
                                      ItemsSource="{Binding OverlayCornerOptions}"
                                      SelectedItem="{Binding SelectedOverlayCorner}"
                                      HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CameraOverlayCornerOption">
                                  <TextBlock Text="{Binding Text}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     AutomationProperties.AutomationId="PrinterOverlayNormalHeader"
                                     Classes="columnHeader"
                                     Text="{Binding [SettingsOverlayNormalColumn], Source={x:Static loc:LocalizedStrings.Instance}}" />
                          <TextBlock Grid.Column="2"
                                     AutomationProperties.AutomationId="PrinterOverlayMiniHeader"
                                     Classes="columnHeader"
                                     Text="{Binding [SettingsCameraWindowMini], Source={x:Static loc:LocalizedStrings.Instance}}" />

                          <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding OverlayRows[0].Text}" />
                          <CheckBox Grid.Row="1"
                                    Grid.Column="1"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayPrinterNameNormal"
                                    AutomationProperties.Name="{Binding OverlayRows[0].NormalName}"
                                    IsChecked="{Binding OverlayRows[0].IsNormal}" />
                          <CheckBox Grid.Row="1"
                                    Grid.Column="2"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayPrinterNameMini"
                                    AutomationProperties.Name="{Binding OverlayRows[0].MiniName}"
                                    IsChecked="{Binding OverlayRows[0].IsMini}" />

                          <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding OverlayRows[1].Text}" />
                          <CheckBox Grid.Row="2"
                                    Grid.Column="1"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayStateNormal"
                                    AutomationProperties.Name="{Binding OverlayRows[1].NormalName}"
                                    IsChecked="{Binding OverlayRows[1].IsNormal}" />
                          <CheckBox Grid.Row="2"
                                    Grid.Column="2"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayStateMini"
                                    AutomationProperties.Name="{Binding OverlayRows[1].MiniName}"
                                    IsChecked="{Binding OverlayRows[1].IsMini}" />

                          <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{Binding OverlayRows[2].Text}" />
                          <CheckBox Grid.Row="3"
                                    Grid.Column="1"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayNozzleTemperatureNormal"
                                    AutomationProperties.Name="{Binding OverlayRows[2].NormalName}"
                                    IsChecked="{Binding OverlayRows[2].IsNormal}" />
                          <CheckBox Grid.Row="3"
                                    Grid.Column="2"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayNozzleTemperatureMini"
                                    AutomationProperties.Name="{Binding OverlayRows[2].MiniName}"
                                    IsChecked="{Binding OverlayRows[2].IsMini}" />

                          <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{Binding OverlayRows[3].Text}" />
                          <CheckBox Grid.Row="4"
                                    Grid.Column="1"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayBedTemperatureNormal"
                                    AutomationProperties.Name="{Binding OverlayRows[3].NormalName}"
                                    IsChecked="{Binding OverlayRows[3].IsNormal}" />
                          <CheckBox Grid.Row="4"
                                    Grid.Column="2"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayBedTemperatureMini"
                                    AutomationProperties.Name="{Binding OverlayRows[3].MiniName}"
                                    IsChecked="{Binding OverlayRows[3].IsMini}" />

                          <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="{Binding OverlayRows[4].Text}" />
                          <CheckBox Grid.Row="5"
                                    Grid.Column="1"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayProgressNormal"
                                    AutomationProperties.Name="{Binding OverlayRows[4].NormalName}"
                                    IsChecked="{Binding OverlayRows[4].IsNormal}" />
                          <CheckBox Grid.Row="5"
                                    Grid.Column="2"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayProgressMini"
                                    AutomationProperties.Name="{Binding OverlayRows[4].MiniName}"
                                    IsChecked="{Binding OverlayRows[4].IsMini}" />

                          <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="{Binding OverlayRows[5].Text}" />
                          <CheckBox Grid.Row="6"
                                    Grid.Column="1"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayRemainingTimeNormal"
                                    AutomationProperties.Name="{Binding OverlayRows[5].NormalName}"
                                    IsChecked="{Binding OverlayRows[5].IsNormal}" />
                          <CheckBox Grid.Row="6"
                                    Grid.Column="2"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayRemainingTimeMini"
                                    AutomationProperties.Name="{Binding OverlayRows[5].MiniName}"
                                    IsChecked="{Binding OverlayRows[5].IsMini}" />

                          <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="{Binding OverlayRows[6].Text}" />
                          <CheckBox Grid.Row="7"
                                    Grid.Column="1"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayFinishTimeNormal"
                                    AutomationProperties.Name="{Binding OverlayRows[6].NormalName}"
                                    IsChecked="{Binding OverlayRows[6].IsNormal}" />
                          <CheckBox Grid.Row="7"
                                    Grid.Column="2"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayFinishTimeMini"
                                    AutomationProperties.Name="{Binding OverlayRows[6].MiniName}"
                                    IsChecked="{Binding OverlayRows[6].IsMini}" />

                          <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="{Binding OverlayRows[7].Text}" />
                          <CheckBox Grid.Row="8"
                                    Grid.Column="1"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayPrintTimeNormal"
                                    AutomationProperties.Name="{Binding OverlayRows[7].NormalName}"
                                    IsChecked="{Binding OverlayRows[7].IsNormal}" />
                          <CheckBox Grid.Row="8"
                                    Grid.Column="2"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayPrintTimeMini"
                                    AutomationProperties.Name="{Binding OverlayRows[7].MiniName}"
                                    IsChecked="{Binding OverlayRows[7].IsMini}" />

                          <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="{Binding OverlayRows[8].Text}" />
                          <CheckBox Grid.Row="9"
                                    Grid.Column="1"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayFileNameNormal"
                                    AutomationProperties.Name="{Binding OverlayRows[8].NormalName}"
                                    IsChecked="{Binding OverlayRows[8].IsNormal}" />
                          <CheckBox Grid.Row="9"
                                    Grid.Column="2"
                                    Classes="cell"
                                    AutomationProperties.AutomationId="PrinterOverlayFileNameMini"
                                    AutomationProperties.Name="{Binding OverlayRows[8].MiniName}"
                                    IsChecked="{Binding OverlayRows[8].IsMini}" />
                        </Grid>
                        <StackPanel Grid.Column="2">
                          <TextBlock AutomationProperties.AutomationId="PrinterOverlayCameraOff"
                                     Classes="hint"
                                     Margin="0,0,0,8"
                                     Text="{Binding [SettingsCameraWindowCameraOff], Source={x:Static loc:LocalizedStrings.Instance}}"
                                     IsVisible="{Binding !CameraEnabled}" />
                          <TextBlock AutomationProperties.AutomationId="PrinterOverlayHint"
                                     Classes="hint"
                                     Margin="0"
                                     Text="{Binding [SettingsOverlayHint], Source={x:Static loc:LocalizedStrings.Instance}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>

      <!-- General: polling interval and language, notifications in two columns, detailed logging. -->
      <TabItem AutomationProperties.AutomationId="SettingsTabGeneral" Header="{Binding [SettingsTabGeneral], Source={x:Static loc:LocalizedStrings.Instance}}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
          <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <StackPanel>
              <TextBlock Classes="label" Text="{Binding [SettingsPollingInterval], Source={x:Static loc:LocalizedStrings.Instance}}" TextWrapping="Wrap" />
              <NumericUpDown AutomationProperties.AutomationId="SettingsPollingInterval"
                             AutomationProperties.Name="{Binding [SettingsPollingInterval], Source={x:Static loc:LocalizedStrings.Instance}}"
                             Value="{Binding PollingIntervalSeconds}"
                             Minimum="{x:Static vm:SettingsViewModel.MinPollingIntervalSeconds}"
                             Maximum="{x:Static vm:SettingsViewModel.MaxPollingIntervalSeconds}"
                             Increment="1"
                             FormatString="0.###"
                             Width="160"
                             HorizontalAlignment="Left" />
              <TextBlock AutomationProperties.AutomationId="SettingsPollingIntervalHint" Classes="hint" Text="{Binding [SettingsPollingIntervalHint], Source={x:Static loc:LocalizedStrings.Instance}}" IsVisible="{Binding ShowsPollingIntervalHint}" />
              <TextBlock AutomationProperties.AutomationId="SettingsPollingIntervalError" Classes="error" Text="{Binding PollingIntervalError}" IsVisible="{Binding PollingIntervalError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="{Binding [SettingsLanguage], Source={x:Static loc:LocalizedStrings.Instance}}" />
              <ComboBox AutomationProperties.AutomationId="SettingsLanguage"
                        AutomationProperties.Name="{Binding [SettingsLanguage], Source={x:Static loc:LocalizedStrings.Instance}}"
                        ItemsSource="{Binding LanguageOptions}"
                        SelectedItem="{Binding SelectedLanguage}"
                        MinWidth="260">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="loc:LanguageOption">
                    <TextBlock Text="{Binding Text}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="hint" Text="{Binding [SettingsLanguageHint], Source={x:Static loc:LocalizedStrings.Instance}}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Classes="section" Text="{Binding [SettingsNotifications], Source={x:Static loc:LocalizedStrings.Instance}}" />
            <CheckBox Grid.Row="2" AutomationProperties.AutomationId="SettingsNotificationsEnabled" Content="{Binding [SettingsNotificationsEnabled], Source={x:Static loc:LocalizedStrings.Instance}}" IsChecked="{Binding NotificationsEnabled}" />
            <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="Auto,12,*" IsEnabled="{Binding NotificationsEnabled}">
              <TextBlock VerticalAlignment="Center" Text="{Binding [SettingsSound], Source={x:Static loc:LocalizedStrings.Instance}}" />
              <ComboBox Grid.Column="2"
                        AutomationProperties.AutomationId="SettingsSound"
                        AutomationProperties.Name="{Binding [SettingsSound], Source={x:Static loc:LocalizedStrings.Instance}}"
                        ItemsSource="{Binding SoundOptions}"
                        SelectedItem="{Binding SelectedSound}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SoundOption">
                    <TextBlock Text="{Binding Text}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <StackPanel Grid.Row="3" Margin="28,0,0,0" IsEnabled="{Binding NotificationsEnabled}">
              <CheckBox Content="{Binding [SettingsNotifyPrintStarted], Source={x:Static loc:LocalizedStrings.Instance}}" IsChecked="{Binding NotifyPrintStarted}" />
              <CheckBox Content="{Binding [SettingsNotifyPrintFinished], Source={x:Static loc:LocalizedStrings.Instance}}" IsChecked="{Binding NotifyPrintFinished}" />
              <CheckBox Content="{Binding [SettingsNotifyPrintPaused], Source={x:Static loc:LocalizedStrings.Instance}}" IsChecked="{Binding NotifyPrintPaused}" />
              <CheckBox Content="{Binding [SettingsNotifyPrintResumed], Source={x:Static loc:LocalizedStrings.Instance}}" IsChecked="{Binding NotifyPrintResumed}" />
              <CheckBox Content="{Binding [SettingsNotifyPrintStopped], Source={x:Static loc:LocalizedStrings.Instance}}" IsChecked="{Binding NotifyPrintStopped}" />
              <!-- T-080: after "stopped" (finished → stopped → cooled down); the threshold is per printer (field in T-092). -->
              <CheckBox AutomationProperties.AutomationId="SettingsNotifyCooledDown"
                        AutomationProperties.HelpText="{Binding [SettingsNotifyCooledDownHelp], Source={x:Static loc:LocalizedStrings.Instance}}"
                        Content="{Binding [SettingsNotifyCooledDown], Source={x:Static loc:LocalizedStrings.Instance}}"
                        IsChecked="{Binding NotifyCooledDown}" />
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" IsEnabled="{Binding NotificationsEnabled}">
              <CheckBox Content="{Binding [SettingsNotifyError], Source={x:Static loc:LocalizedStrings.Instance}}" IsChecked="{Binding NotifyError}" />
              <CheckBox Content="{Binding [SettingsNotifyAttention], Source={x:Static loc:LocalizedStrings.Instance}}" IsChecked="{Binding NotifyAttention}" />
              <CheckBox Content="{Binding [SettingsNotifyOffline], Source={x:Static loc:LocalizedStrings.Instance}}" IsChecked="{Binding NotifyOffline}" />
              <TextBlock Classes="label" Margin="0,8,0,4" TextWrapping="Wrap" Text="{Binding [SettingsRemainingTime], Source={x:Static loc:LocalizedStrings.Instance}}" />
              <NumericUpDown AutomationProperties.AutomationId="SettingsRemainingTime"
                             AutomationProperties.Name="{Binding [SettingsRemainingTime], Source={x:Static loc:LocalizedStrings.Instance}}"
                             Value="{Binding RemainingTimeMinutes}"
                             Minimum="0"
                             Maximum="{x:Static vm:SettingsViewModel.MaxRemainingTimeMinutes}"
                             Increment="1"
                             FormatString="0"
                             Width="160"
                             HorizontalAlignment="Left" />
              <TextBlock AutomationProperties.AutomationId="SettingsRemainingTimeError" Classes="error" Text="{Binding RemainingTimeError}" IsVisible="{Binding RemainingTimeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <!-- T-047: detailed logging; its own row below the notifications, the hint to its right (no room for a section heading, T-033 fit). -->
            <CheckBox Grid.Row="4"
                      AutomationProperties.AutomationId="SettingsDebugLogging"
                      AutomationProperties.HelpText="{Binding [SettingsDebugLoggingHint], Source={x:Static loc:LocalizedStrings.Instance}}"
                      Margin="0,12,0,0"
                      VerticalAlignment="Top"
                      Content="{Binding [SettingsDebugLogging], Source={x:Static loc:LocalizedStrings.Instance}}"
                      IsChecked="{Binding DebugLogging}" />
            <TextBlock Grid.Row="4"
                       Grid.Column="2"
                       AutomationProperties.AutomationId="SettingsDebugLoggingHint"
                       Classes="hint"
                       Margin="0,12,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding [SettingsDebugLoggingHint], Source={x:Static loc:LocalizedStrings.Instance}}" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!--
        T-017: start after logon (Windows only, off by default; applied by Save) and pre-release updates. A tab of its own (user
        decision 2026-10-24): the General tab has no room left within the 800 × 600 fit of T-033.
      -->
      <TabItem AutomationProperties.AutomationId="SettingsTabStartupUpdates" Header="{Binding [SettingsTabStartupUpdates], Source={x:Static loc:LocalizedStrings.Instance}}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
          <StackPanel Spacing="12">
            <!--
              Only the installed app (user decision 2026-10-24): a .zip or a development build shows both options disabled with
              the reason, which is also their help text (a disabled check box cannot be focused).
            -->
            <StackPanel IsVisible="{Binding IsAutostartShown}">
              <CheckBox AutomationProperties.AutomationId="SettingsStartWithWindows"
                        AutomationProperties.HelpText="{Binding AutostartHelpText}"
                        IsEnabled="{Binding IsAutostartAvailable}"
                        Content="{Binding [SettingsStartWithWindows], Source={x:Static loc:LocalizedStrings.Instance}}"
                        IsChecked="{Binding StartWithWindows}" />
              <TextBlock AutomationProperties.AutomationId="SettingsStartWithWindowsNotInstalled"
                         Classes="hint"
                         Margin="28,0,0,0"
                         IsVisible="{Binding ShowsAutostartNeedsInstallation}"
                         Text="{Binding [SettingsNeedsInstallation], Source={x:Static loc:LocalizedStrings.Instance}}" />
            </StackPanel>
            <StackPanel>
              <CheckBox AutomationProperties.AutomationId="SettingsOfferPrereleaseUpdates"
                        AutomationProperties.HelpText="{Binding PrereleaseHelpText}"
                        IsEnabled="{Binding IsPrereleaseOptionAvailable}"
                        Content="{Binding [SettingsOfferPrereleaseUpdates], Source={x:Static loc:LocalizedStrings.Instance}}"
                        IsChecked="{Binding OfferPrereleaseUpdates}" />
              <TextBlock AutomationProperties.AutomationId="SettingsOfferPrereleaseUpdatesHint"
                         Classes="hint"
                         Margin="28,0,0,0"
                         IsVisible="{Binding IsPrereleaseOptionAvailable}"
                         Text="{Binding [SettingsOfferPrereleaseUpdatesHint], Source={x:Static loc:LocalizedStrings.Instance}}" />
              <TextBlock AutomationProperties.AutomationId="SettingsOfferPrereleaseUpdatesNotInstalled"
                         Classes="hint"
                         Margin="28,0,0,0"
                         IsVisible="{Binding ShowsAutostartNeedsInstallation}"
                         Text="{Binding [SettingsNeedsInstallation], Source={x:Static loc:LocalizedStrings.Instance}}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Save / Cancel and the outcome of the last save attempt. -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
      <TextBlock AutomationProperties.AutomationId="SettingsStatus"
                 Classes="status"
                 Classes.isError="{Binding StatusIsError}"
                 Text="{Binding StatusText}"
                 IsVisible="{Binding HasStatus}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0" />
      <Button Grid.Column="1"
              Classes="accent"
              MinWidth="96"
              Content="{Binding [SettingsSave], Source={x:Static loc:LocalizedStrings.Instance}}"
              AutomationProperties.AutomationId="SettingsSave"
              Command="{Binding SaveCommand}"
              IsDefault="True" />
      <Button Grid.Column="2"
              MinWidth="96"
              Margin="8,0,0,0"
              Content="{Binding [SettingsCancel], Source={x:Static loc:LocalizedStrings.Instance}}"
              AutomationProperties.AutomationId="SettingsCancel"
              Command="{Binding CancelCommand}"
              IsCancel="True" />
    </Grid>
  </Grid>
</Window>
