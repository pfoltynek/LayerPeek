<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- FFmpeg structures are accessed through pointers (FFmpeg.AutoGen). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!--
    Built for the RID of an app (LayerPeekAppRuntimeIdentifier, below): an output folder per RID (bin\<config>\app-<rid>\
    <tfm>\), so the native libraries of win-x64 and win-arm64 never share one folder (T-225: the copy is PreserveNewest,
    so a newer ARM64 DLL would otherwise stay in the folder of a later x64 build). The SDK appends the framework.
  -->
  <PropertyGroup Condition="'$(LayerPeekAppRuntimeIdentifier)' != ''">
    <OutputPath>bin\$(Configuration)\app-$(LayerPeekAppRuntimeIdentifier)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen.Abstractions" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLinked" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LayerPeek.Camera.FFmpeg.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!--
      LayerPeekAppRuntimeIdentifier (below) is a global property of this project only: Core must not get it, or it would
      be built a second time as another project instance into the same obj/bin (T-224).
    -->
    <ProjectReference Include="..\LayerPeek.Core\LayerPeek.Core.csproj" UndefineProperties="LayerPeekAppRuntimeIdentifier" GlobalPropertiesToRemove="LayerPeekAppRuntimeIdentifier" />
  </ItemGroup>
  <!--
    Native FFmpeg DLLs; they flow to the output and publish directory of every referencing project. Which build
    (win-x64, win-arm64 since T-225, osx-arm64) follows LayerPeekAppRuntimeIdentifier, the RID of the app that references
    this RID-agnostic library (set by LayerPeek.App.csproj and the FFmpeg tests for every RID, T-224), see
    build/FFmpeg.targets.
  -->
  <Import Project="..\..\build\FFmpeg.targets" />
</Project>
