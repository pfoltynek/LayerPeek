<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- FFmpeg structures are accessed through pointers (FFmpeg.AutoGen). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen.Abstractions" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLinked" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LayerPeek.Camera.FFmpeg.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LayerPeek.Core\LayerPeek.Core.csproj" />
  </ItemGroup>
  <!-- Native FFmpeg DLLs; they flow to the output and publish directory of every referencing project. -->
  <Import Project="..\..\build\FFmpeg.targets" />
</Project>
