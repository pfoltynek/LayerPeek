<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrusaTrayDiagnostic.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <!--
    Icon and tooltip are replaced at runtime by TrayIconPresenter; the static icon is the fallback if rendering fails.
    The menu is filled at runtime by TrayMenuPresenter (printers, settings, about, quit).
  -->
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/tray-idle.png" ToolTipText="Prusa Tray Diagnostic">
        <TrayIcon.Menu>
          <NativeMenu />
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
