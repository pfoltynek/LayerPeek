<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PrusaTrayDiagnostic</AssemblyName>
    <PublishAot>true</PublishAot>
    <!--
      The .NET 11 SDK "optimized publish" for Native AOT runs PrepareResources before ResolveReferences.
      Avalonia adds its !AvaloniaResources embedded resource in a target hooked before ResolveReferences,
      so on that path the resource misses SplitResourcesByCulture, is never embedded, XAML is not compiled
      and the published exe throws "No precompiled XAML found" at startup. Use the regular full build.
    -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Required by [LibraryImport] interop with pointer types (Platform/*). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PrusaTrayDiagnostic.App.Tests" />
    <InternalsVisibleTo Include="PrusaTrayDiagnostic.App.UiTests" />
  </ItemGroup>
  <PropertyGroup>
    <!-- English strings live in the main assembly; other languages in satellite assemblies (compiled into the AOT binary). -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Third-party licence texts (About window), read by exact name: see Licenses/ThirdPartyLicenses.cs. -->
    <EmbeddedResource Include="Licenses\Texts\*.txt" LogicalName="PrusaTrayDiagnostic.Licenses.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Strongly typed accessor generated by MSBuild at build time (no Visual Studio designer file in the repo). -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>PrusaTrayDiagnostic.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <!-- Public: compiled XAML ({x:Static}) only resolves public members. -->
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <!--
    The ASP.NET Core shared framework (Kestrel for the local web proxy, T-028) ships the native IIS in-process module
    aspnetcorev2_inprocess.dll as a runtime pack asset. The app never runs under IIS, so it is left out of the build and
    publish output (decided by the user 2026-10-18). ResolveRuntimePackAssets also adds it to ReferenceCopyLocalPaths.
  -->
  <Target Name="ExcludeAspNetCoreIisModule" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\PrusaTrayDiagnostic.Core\PrusaTrayDiagnostic.Core.csproj" />
    <ProjectReference Include="..\PrusaTrayDiagnostic.PrusaLink\PrusaTrayDiagnostic.PrusaLink.csproj" />
    <ProjectReference Include="..\PrusaTrayDiagnostic.PrusaConnect\PrusaTrayDiagnostic.PrusaConnect.csproj" />
    <!-- Camera decoder (T-014); its native FFmpeg DLLs flow here through the reference (do not import build/FFmpeg.targets). -->
    <ProjectReference Include="..\PrusaTrayDiagnostic.Camera.FFmpeg\PrusaTrayDiagnostic.Camera.FFmpeg.csproj" />
  </ItemGroup>
</Project>
