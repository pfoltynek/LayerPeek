<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PrusaTrayDiagnostic</AssemblyName>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Required by [LibraryImport] interop with pointer types (Platform/*). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PrusaTrayDiagnostic.App.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <!-- English strings live in the main assembly; other languages in satellite assemblies (compiled into the AOT binary). -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Strongly typed accessor generated by MSBuild at build time (no Visual Studio designer file in the repo). -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>PrusaTrayDiagnostic.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <!-- Public: compiled XAML ({x:Static}) only resolves public members. -->
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PrusaTrayDiagnostic.Core\PrusaTrayDiagnostic.Core.csproj" />
    <ProjectReference Include="..\PrusaTrayDiagnostic.PrusaLink\PrusaTrayDiagnostic.PrusaLink.csproj" />
    <ProjectReference Include="..\PrusaTrayDiagnostic.PrusaConnect\PrusaTrayDiagnostic.PrusaConnect.csproj" />
  </ItemGroup>
</Project>
