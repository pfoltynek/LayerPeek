<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrusaTrayDiagnostic.App.Windows"
        x:Class="PrusaTrayDiagnostic.App.Windows.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterScreen"
        MinWidth="320">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SupportErrorBrush" Color="#C42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SupportErrorBrush" Color="#FF99A4" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <!-- The support buttons share the width of the widest, texts left-aligned. -->
    <Style Selector="Grid.support > Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.supportStatus.isError">
      <Setter Property="Foreground" Value="{DynamicResource SupportErrorBrush}" />
    </Style>
  </Window.Styles>
  <!-- Fixed width (T-048 design): a status or a longer translation wraps instead of widening the window. -->
  <StackPanel Margin="24" Spacing="8" Width="400">
    <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="{Binding VersionText}" />
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" Opacity="0.75" />
    <TextBlock Text="{Binding LicenseText}" Margin="0,8,0,0" />
    <TextBlock Text="{Binding Copyright}" />
    <!-- Opened through IUrlLauncher (validated http(s) address), not through NavigateUri. -->
    <HyperlinkButton Content="{Binding RepositoryText}" Command="{Binding OpenRepositoryCommand}" Padding="0" />
    <!-- FFmpeg (LGPL) and all other shipped components with their full licence texts (T-014). -->
    <HyperlinkButton Content="{Binding ThirdPartyLicensesText}" Command="{Binding ShowLicensesCommand}" Padding="0" />

    <!-- T-048/T-049: support actions, one group below the links (buttons: actions, not navigation). -->
    <TextBlock AutomationProperties.AutomationId="SupportHeading" Margin="0,8,0,-4" FontWeight="SemiBold" Text="{Binding SupportHeading}" />
    <!-- One Auto column: the buttons share the width of the widest. -->
    <Grid Classes="support" ColumnDefinitions="Auto" RowDefinitions="Auto,8,Auto" HorizontalAlignment="Left">
      <Button AutomationProperties.AutomationId="SupportSaveBundle"
              ToolTip.Tip="{Binding SaveBundleTip}"
              Content="{Binding SaveBundleText}"
              Command="{Binding SaveBundleCommand}" />
      <Button Grid.Row="2"
              AutomationProperties.AutomationId="SupportOpenLogFolder"
              Content="{Binding OpenLogFolderText}"
              Command="{Binding OpenLogFolderCommand}" />
    </Grid>

    <!-- Status left of Close (like the settings window); the row keeps 48 DIP so 1–3 status lines never resize the window. -->
    <Grid ColumnDefinitions="*,16,Auto" MinHeight="48" Margin="0,8,0,0">
      <TextBlock AutomationProperties.AutomationId="SupportStatus"
                 AutomationProperties.LiveSetting="Polite"
                 Classes="supportStatus"
                 Classes.isError="{Binding SupportStatusIsError}"
                 Text="{Binding SupportStatusText}"
                 IsVisible="{Binding SupportStatusText, Converter={x:Static ObjectConverters.IsNotNull}}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
      <Button Grid.Column="2"
              AutomationProperties.AutomationId="AboutClose"
              VerticalAlignment="Bottom"
              Content="{Binding CloseText}"
              IsDefault="True"
              IsCancel="True"
              Click="OnCloseClicked" />
    </Grid>
  </StackPanel>
</Window>
