<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!--
    Tests of the repository scripts (T-055): runs the Pester tests of scripts/ReleaseTools through pwsh, so that
    dotnet test covers them. Skipped (not failed) when pwsh or Pester 5+ is missing. No reference to the src projects.
  -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TestRunLock.cs" Link="Shared\TestRunLock.cs" />
    <Compile Include="..\Shared\TestWorktree.cs" Link="Shared\TestWorktree.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
