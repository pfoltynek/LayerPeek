<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows only (T-044): UI Automation, Win32 window styles and the taskbar property store of the real exe. -->
    <TargetFramework>net11.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- PROPVARIANT and window style interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <!--
      macOS (and Linux): the solution still restores and builds (Windows targeting packs, no NETSDK1100), but the project
      is not a test application there, so `dotnet test` of the solution skips it. Not yet verified on a Mac (first macOS
      task, see T-044).
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <!--
      End-to-end tests of the real PrusaTrayDiagnostic.exe (Debug build, isolated test mode) through UI Automation.
      They run only on demand (tools/run-e2e.ps1 sets PTD_E2E=1); a normal `dotnet test` skips every test. The app is
      not referenced: the tests start the exe built in src/PrusaTrayDiagnostic.App/bin/Debug.
    -->
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Simulated PrusaLink printer and Buddy3D RTSP camera (T-045), shared with the developer tool. -->
    <ProjectReference Include="..\..\tools\PrusaSimulator\PrusaSimulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TestRunLock.cs" Link="Shared\TestRunLock.cs" />
    <Compile Include="..\Shared\TestWorktree.cs" Link="Shared\TestWorktree.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Recorded captures (only the test toast's own region) for the offline image checks. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
