<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- CredEnumerateW interop in test cleanup helpers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Recorded answers of the GitHub REST API (T-058). -->
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LayerPeek.App\LayerPeek.App.csproj" />
    <!-- Simulated PrusaLink printer (T-045) for the on-demand E2E test of macOS notifications (T-020). -->
    <ProjectReference Include="..\..\tools\PrusaSimulator\PrusaSimulator.csproj" />
  </ItemGroup>
</Project>
