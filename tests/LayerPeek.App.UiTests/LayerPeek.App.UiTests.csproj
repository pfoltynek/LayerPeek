<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Same as the app: the views under test keep compiled bindings. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Reading pixels of captured frames (camera window tests, T-014). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Headless UI tests (T-031): the plain Avalonia.Headless platform with an own xUnit v3 assembly fixture
      (Infrastructure/HeadlessSession.cs). Avalonia.Headless.XUnit is not used: 12.1.4 is built against
      xunit.v3.extensibility.core 3.2.2 and fails test discovery with xunit.v3 4.x. Skia renders the snapshot tests,
      Inter is the only font they use (no installed system font). All test-only, not AOT relevant.
    -->
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference images of the snapshot tests live in the source tree (updated with LAYERPEEK_UPDATE_SNAPSHOTS=1). -->
    <AssemblyMetadata Include="SnapshotDirectory" Value="$(MSBuildProjectDirectory)$([System.IO.Path]::DirectorySeparatorChar)Snapshots" />
    <!-- The README screenshots (opt-in generator, LAYERPEEK_README_SCREENSHOTS=1) are written to docs/images. -->
    <AssemblyMetadata Include="ReadmeImageDirectory" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../docs/images'))" />
  </ItemGroup>
  <ItemGroup>
    <!-- The recorded Buddy3D clip of T-014, the camera picture of the README screenshots; linked, not copied. -->
    <None Include="..\LayerPeek.Camera.FFmpeg.Tests\Fixtures\buddy3d.h264" Link="Fixtures\buddy3d.h264" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TestRunLock.cs" Link="Shared\TestRunLock.cs" />
    <Compile Include="..\Shared\TestWorktree.cs" Link="Shared\TestWorktree.cs" />
    <!-- The fakes of the view model tests, linked (no copy that could diverge). -->
    <Compile Include="..\LayerPeek.App.Tests\Settings\SettingsFakes.cs" Link="Shared\SettingsFakes.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Tray\TrayFakes.cs" Link="Shared\TrayFakes.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Tray\Menu\MenuFakes.cs" Link="Shared\MenuFakes.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Tray\Menu\FakeWebGateway.cs" Link="Shared\FakeWebGateway.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Cameras\CameraFakes.cs" Link="Shared\CameraFakes.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Cameras\FakeScreenCatalog.cs" Link="Shared\FakeScreenCatalog.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Cameras\Overlay\TestOverlayWidget.cs" Link="Shared\TestOverlayWidget.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Cameras\Layout\LayoutFakes.cs" Link="Shared\LayoutFakes.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Settings\WidgetSettingsFakes.cs" Link="Shared\WidgetSettingsFakes.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Printers\ImageFakes.cs" Link="Shared\ImageFakes.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Diagnostics\DiagnosticsFakes.cs" Link="Shared\DiagnosticsFakes.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Platform\FakeLocalNetworkPrivacy.cs" Link="Shared\FakeLocalNetworkPrivacy.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Settings\NotificationSettingsFakes.cs" Link="Shared\NotificationSettingsFakes.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Platform\RecordingAppPresence.cs" Link="Shared\RecordingAppPresence.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Previews\PreviewFakes.cs" Link="Shared\PreviewFakes.cs" />
    <Compile Include="..\LayerPeek.App.Tests\Platform\MacOS\BlockingKeychainItems.cs" Link="Shared\BlockingKeychainItems.cs" />
    <Compile Include="..\Shared\TestPng.cs" Link="Shared\TestPng.cs" />
    <Compile Include="..\Shared\CultureTime.cs" Link="Shared\CultureTime.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LayerPeek.App\LayerPeek.App.csproj" />
    <!-- The G-code previews of the simulated print files (T-086) for the README screenshots, instead of a test-only copy. -->
    <ProjectReference Include="..\..\tools\PrusaSimulator\PrusaSimulator.csproj" />
  </ItemGroup>
</Project>
