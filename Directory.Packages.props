<Project>
  <ItemGroup Label="App">
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Camera">
    <!-- MIT; [DllImport] bindings, verified for Native AOT (T-014). Native FFmpeg DLLs: build/FFmpeg.targets. -->
    <PackageVersion Include="FFmpeg.AutoGen.Abstractions" Version="9.0.1.1" />
    <PackageVersion Include="FFmpeg.AutoGen.Bindings.DynamicallyLinked" Version="9.0.1.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <!-- MIT; headless Avalonia UI tests (T-014), only tests/PrusaTrayDiagnostic.App.UiTests, never shipped. Built against xunit.v3 3.x. -->
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
